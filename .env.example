# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real keys.

# --- Supabase -------------------------------------------------------------
# Project Settings -> API. The service role key bypasses Row Level Security and is
# used only in server-side code. It must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ^ Project Settings -> API Keys -> "Secret keys" -> the sb_secret_... value.
# NOT the publishable key. Supabase renamed these: publishable = old anon,
# secret = old service_role. Either naming works; the secret one is what we need.

# --- Voyage AI (embeddings) ----------------------------------------------
# https://dashboard.voyageai.com — current models include 200M free tokens,
# which is far more than this project will ever use.
VOYAGE_API_KEY=

# --- Anthropic (answers) --------------------------------------------------
# https://console.anthropic.com — not needed until Phase 2.
# Set a monthly spend cap in the console before going live.
ANTHROPIC_API_KEY=

# --- Development only ------------------------------------------------------
# Messages allowed per IP per day. Development trips the default of 20 quickly,
# since every test comes from the same address. Leave unset in production.
DAILY_IP_LIMIT=500

# --- Browser-side Supabase (auth only) --------------------------------------
# Project Settings -> API Keys -> "Publishable key". Safe in the client bundle by
# design: RLS is on for every table with no policies, so this key can read nothing.
# It exists so the practice can sign in to the dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
